    "docs/architecture",
    "docs/specs",
    "production/epics",
    "production/qa",
    "production/sprints",
    "studio-tests/catalog.yaml",
    "templates",
    ".aider.conf.yml",
    ".aiderignore",
    ".clinerules",
    ".cursorrules",
    ".roomodes",
    ".windsurfrules",
    "AGENTS.md",
    "CLAUDE.md",
    "CODEX.md",
    "CONVENTIONS.md",
    "GEMINI.md",
    "project.yaml",
    "project.local.yaml.example",
    "README.md",
    "README.en.md"
