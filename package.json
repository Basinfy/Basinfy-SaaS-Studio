    "scripts",
    ".agents/AGENTS.md",
    ".agents/PORTABLE-RUNTIME.md",
    ".agents/skills/basinfy-saas-studio",
    ".basinfy/experience",
    ".claude",
    ".codex",
    ".continue",
    ".cursor",
    ".devin",
    ".github/copilot-instructions.md",
    ".github/prompts",
