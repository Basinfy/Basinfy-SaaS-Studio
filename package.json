  "scripts": {
    "test": "python studio-tests/verify-integrity.py",
    "test:bench": "python studio-tests/bench/run-bench.py",
    "test:package": "python studio-tests/test-package.py",
    "test:client": "python studio-tests/client-smoke.py",
    "sync:skills": "python scripts/sync-agent-skills.py",
    "sync:configs": "node scripts/build-client-configs.mjs",
    "cli": "node bin/cli.js",
    "cli:help": "node bin/cli.js --help",
    "cli:uninstall": "node bin/cli.js uninstall"
  },
  "keywords": [
