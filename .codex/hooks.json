{
  "description": "Basinfy SaaS Studio Codex hooks",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "apply_patch",
        "hooks": [{"type": "command", "command": "node .codex/studio-hook.cjs pre", "timeout": 10}]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "apply_patch",
        "hooks": [{"type": "command", "command": "node .codex/studio-hook.cjs post", "timeout": 10}]
      },
      {
        "matcher": "Bash",
        "hooks": [{"type": "command", "command": "node .codex/studio-hook.cjs shell", "timeout": 5}]
      }
    ]
  }
}
